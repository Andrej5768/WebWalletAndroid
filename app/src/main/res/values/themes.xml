<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window theme; everything visible is drawn by Compose. Edge-to-edge is enabled at runtime. -->
    <style name="Theme.WebWallet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
    </style>

    <!-- System splash screen (docs/02 §7): the launcher icon on a cobalt background, then the app theme -->
    <style name="Theme.WebWallet.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cobalt</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WebWallet</item>
    </style>
</resources>
